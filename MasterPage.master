<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterPage.master.cs" Inherits="All_In_One_Ecommerce.MasterPage" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - ShopX Online Shopping</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 & Icons -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <!-- Custom Styles (ShopX Theme) -->
    <link href="~/css/style.css" rel="stylesheet" />
    <link href="~/css/products.css" rel="stylesheet" />

    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- TOP ANNOUNCEMENT BAR (BLACK WITH RED ACCENT) -->
        <div class="top-announcement-bar">
            <div class="header-container">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div class="d-flex align-items-center">
                        <svg class="tag-icon" width="14" height="14" viewBox="0 0 24 24" fill="#e60000" style="margin-right: 6px;">
                            <path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 6.33 7 5.5 7z"/>
                        </svg>
                        <span>Free Shipping on Orders Above &#8377;999</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="#ffffff">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </svg>
                        <a href="Login.aspx" class="text-white text-decoration-none">Login</a>
                        <span class="text-secondary">|</span>
                        <a href="Register.aspx" class="text-white text-decoration-none">Register</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- MAIN HEADER / NAVBAR (EXACT PIXEL-PERFECT REFERENCE MATCH) -->
        <header class="main-header">
            <div class="header-container">
                <div class="main-header-inner">
                    <!-- Brand Logo -->
                    <a href="Index.aspx" class="brand-logo">
                        <img src="images/logo.png" alt="ShopX" class="brand-logo-img" />
                        <span class="brand-name-shopx">Shop<span>X</span></span>
                    </a>

                    <!-- Navigation Links -->
                    <nav class="d-none d-lg-block">
                        <ul class="nav-shopx">
                            <li><a href="Index.aspx" class="nav-shopx-link active">Home</a></li>
                            <li class="dropdown">
                                <a href="#" class="nav-shopx-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    Categories
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="dropdown-chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                </a>
                                <ul class="dropdown-menu shadow border-0 py-2">
                                    <li><a class="dropdown-item py-2 fw-semibold" href="Products.aspx?cat=fashion"><i class="bi bi-gender-ambiguous me-2 text-danger"></i> Fashion</a></li>
                                    <li><a class="dropdown-item py-2 fw-semibold" href="Products.aspx?cat=electronics"><i class="bi bi-phone me-2 text-danger"></i> Electronics</a></li>
                                    <li><a class="dropdown-item py-2 fw-semibold" href="Products.aspx?cat=laptops"><i class="bi bi-laptop me-2 text-danger"></i> Laptops</a></li>
                                    <li><a class="dropdown-item py-2 fw-semibold" href="Products.aspx?cat=footwear"><i class="bi bi-trophy me-2 text-danger"></i> Footwear</a></li>
                                    <li><a class="dropdown-item py-2 fw-semibold" href="Products.aspx?cat=bags"><i class="bi bi-handbag me-2 text-danger"></i> Bags</a></li>
                                    <li><a class="dropdown-item py-2 fw-semibold" href="Products.aspx?cat=watches"><i class="bi bi-watch me-2 text-danger"></i> Watches</a></li>
                                    <li><a class="dropdown-item py-2 fw-semibold" href="Products.aspx?cat=beauty"><i class="bi bi-sparkles me-2 text-danger"></i> Beauty</a></li>
                                    <li><a class="dropdown-item py-2 fw-semibold" href="Products.aspx?cat=furniture"><i class="bi bi-lamp me-2 text-danger"></i> Home &amp; Living</a></li>
                                </ul>
                            </li>
                            <li><a href="Products.aspx" class="nav-shopx-link">Products</a></li>
                            <li><a href="Products.aspx?filter=offers" class="nav-shopx-link">Offers</a></li>
                            <li><a href="About.aspx" class="nav-shopx-link">About</a></li>
                            <li><a href="Contact.aspx" class="nav-shopx-link">Contact</a></li>
                        </ul>
                    </nav>

                    <!-- Right Header Items: Search Bar, Wishlist & Cart -->
                    <div class="header-actions-right">
                        <!-- Search Bar -->
                        <div class="search-bar-shopx">
                            <input type="text" id="txtHeaderSearch" placeholder="Search products..." />
                            <button type="button" class="btn-search-shopx" title="Search" onclick="window.location.href='Products.aspx?search=' + encodeURIComponent(document.getElementById('txtHeaderSearch').value);">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                            </button>
                        </div>

                        <!-- Icons Wrap: Wishlist & Cart -->
                        <div class="header-icon-wrap">
                            <a href="Wishlist.aspx" class="icon-btn-shopx" title="Wishlist">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                </svg>
                                <span class="badge-count wishlist-badge-count">0</span>
                            </a>

                            <a href="Cart.aspx" class="icon-btn-shopx" title="Shopping Cart">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                                <span class="badge-count cart-badge-count">0</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- PAGE CONTENT CONTAINER -->
        <main>
            <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <!-- FOOTER (MATCHING REFERENCE IMAGE) -->
        <footer class="footer-shopx">
            <div class="header-container">
                <div class="footer-inner-grid">
                    <!-- Brand -->
                    <div class="footer-col-brand">
                        <a href="Index.aspx" class="brand-logo">
                            <img src="images/logo.png" alt="ShopX" class="brand-logo-img" />
                            <span class="brand-name-shopx text-white">Shop<span>X</span></span>
                        </a>
                    </div>

                    <!-- Divider -->
                    <div class="footer-v-divider d-none d-md-block"></div>

                    <!-- Quick Links -->
                    <div class="footer-col-links">
                        <h6 class="footer-col-title">Quick Links</h6>
                        <div class="footer-links-inline">
                            <a href="Index.aspx">Home</a>
                            <a href="Products.aspx">Categories</a>
                            <a href="Products.aspx?filter=offers">Offers</a>
                            <a href="Contact.aspx">Contact</a>
                        </div>
                    </div>

                    <!-- Divider -->
                    <div class="footer-v-divider d-none d-lg-block"></div>

                    <!-- Get In Touch -->
                    <div class="footer-col-contact">
                        <h6 class="footer-col-title">Get In Touch</h6>
                        <div class="footer-contact-row">
                            <a href="mailto:support@shopx.com" class="footer-info-item">
                                <i class="bi bi-envelope-fill me-1"></i> support@shopx.com
                            </a>
                            <a href="tel:+919876543210" class="footer-info-item ms-3">
                                <i class="bi bi-telephone-fill me-1"></i> +91 98765 43210
                            </a>
                        </div>
                    </div>

                    <!-- Divider -->
                    <div class="footer-v-divider d-none d-lg-block"></div>

                    <!-- Follow Us -->
                    <div class="footer-col-social">
                        <h6 class="footer-col-title">Follow Us</h6>
                        <div class="footer-social-row">
                            <a href="#" class="social-circle-white" title="Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="social-circle-white" title="Instagram"><i class="bi bi-instagram"></i></a>
                            <a href="#" class="social-circle-white" title="YouTube"><i class="bi bi-youtube"></i></a>
                            <a href="#" class="social-circle-white" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </footer>

        <!-- Back to Top Button -->
        <a href="#" class="back-to-top" id="backToTopBtn" title="Back to top">
            <i class="bi bi-arrow-up"></i>
        </a>
    </form>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js"></script>
    <script src="~/js/cart.js"></script>
    <script src="~/js/products.js"></script>
</body>
</html>
